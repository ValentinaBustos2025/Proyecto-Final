@article{imhofEvolutionaryGameDynamics2006,
  title = {Evolutionary Game Dynamics in a {{Wright-Fisher}} Process},
  author = {Imhof, Lorens A. and Nowak, Martin A.},
  date = {2006-05},
  journaltitle = {Journal of Mathematical Biology},
  shortjournal = {J. Math. Biol.},
  volume = {52},
  number = {5},
