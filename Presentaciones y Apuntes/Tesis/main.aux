\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Evolutionary regimes obtained from the numerical parameter search of the constant-payoff model. The parameters $\eta _d$ and $r_0$ were determined using SciPy. A dominance, B dominance, stable coexistence, and neutrality were identified, whereas bistability was not found within the investigated parameter range.}}{25}{table.2}\protected@file@percent }
\newlabel{tab:linermatrixdynamics}{{2}{25}{Evolutionary regimes obtained from the numerical parameter search of the constant-payoff model. The parameters $\eta _d$ and $r_0$ were determined using SciPy. A dominance, B dominance, stable coexistence, and neutrality were identified, whereas bistability was not found within the investigated parameter range}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Frequency-Dependt Evolutionary Equilibria}{25}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Deterministic replicator dynamics of the sexually selected phenotype A under five evolutionary regimes: (I) A dominance, (II) B dominance, (III) stable coexistence, (IV) bistability, and (V) neutrality. Each curve represents a different initial phenotype frequency ($p_0$), while predation intensity ($\eta _d$) and reproductive advantage ($r_0$) remain fixed within each scenario. The horizontal axis represents simulation steps in arbitrary time units, and the vertical axis represents the proportion of phenotype A. The corresponding frequencies maximizing mean population fitness are $p_{\max }\approx 0.7105$, $0$, $0.25$, and $1$ for regimes I--IV, respectively. In the neutral regime (V), mean fitness is constant for all population compositions. These fitness maxima do not necessarily coincide with the stable evolutionary equilibria.}}{26}{figure.4}\protected@file@percent }
\newlabel{fig:replicator}{{4}{26}{Deterministic replicator dynamics of the sexually selected phenotype A under five evolutionary regimes: (I) A dominance, (II) B dominance, (III) stable coexistence, (IV) bistability, and (V) neutrality. Each curve represents a different initial phenotype frequency ($p_0$), while predation intensity ($\eta _d$) and reproductive advantage ($r_0$) remain fixed within each scenario. The horizontal axis represents simulation steps in arbitrary time units, and the vertical axis represents the proportion of phenotype A. The corresponding frequencies maximizing mean population fitness are $p_{\max }\approx 0.7105$, $0$, $0.25$, and $1$ for regimes I--IV, respectively. In the neutral regime (V), mean fitness is constant for all population compositions. These fitness maxima do not necessarily coincide with the stable evolutionary equilibria}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Deterministic replicator dynamics of the sexually selected phenotype A under two evolutionary regimes: (I) dominance of phenotype A at \((\eta _d=0)\) and (II) stable coexistence at \((\eta _d=1)\). Each curve represents a different initial proportion of phenotype A (\(p_0)\), while predation intensity \(\eta _d)\) remains fixed within each scenario. The horizontal axis represents simulation steps in arbitrary time units, whereas the vertical axis represents the proportion of phenotype A in the population, \(p\). In both regimes, trajectories with different initial proportions converge toward the same equilibrium, determined by the corresponding predation intensity.}}{27}{figure.5}\protected@file@percent }
\newlabel{fig:replicatorFreqDep}{{5}{27}{Deterministic replicator dynamics of the sexually selected phenotype A under two evolutionary regimes: (I) dominance of phenotype A at \((\eta _d=0)\) and (II) stable coexistence at \((\eta _d=1)\). Each curve represents a different initial proportion of phenotype A (\(p_0)\), while predation intensity \(\eta _d)\) remains fixed within each scenario. The horizontal axis represents simulation steps in arbitrary time units, whereas the vertical axis represents the proportion of phenotype A in the population, \(p\). In both regimes, trajectories with different initial proportions converge toward the same equilibrium, determined by the corresponding predation intensity}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Summary of the evolutionary regimes observed in the frequency-dependent payoff model as a function of predation intensity ($\eta _d$). The transition between dominance of phenotype A and stable coexistence occurs at approximately $\eta _d = 0.510$.}}{27}{table.3}\protected@file@percent }
\newlabel{tab:frequencydependentdynamics}{{3}{27}{Summary of the evolutionary regimes observed in the frequency-dependent payoff model as a function of predation intensity ($\eta _d$). The transition between dominance of phenotype A and stable coexistence occurs at approximately $\eta _d = 0.510$}{table.3}{}}
